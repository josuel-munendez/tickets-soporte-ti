    {
      "name": "Tickets",
      "item": [
        {
          "name": "Listar tickets (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["tickets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            },
            "description": "Lista paginada. per_page por defecto 10, máximo 50."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Estructura data + meta', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.meta).to.have.property('total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar con filtros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets?estado=EN CURSO&prioridad=Alta&q=vpn&page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["tickets"],
              "query": [
                { "key": "estado", "value": "EN CURSO" },
                { "key": "prioridad", "value": "Alta" },
                { "key": "q", "value": "vpn" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            },
            "description": "Filtros por estado, prioridad, técnico y texto libre."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de un ticket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tickets/{{numero}}",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{numero}}"]
            },
            "description": "Detalle del ticket con su historial completo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Incluye historial', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('historial');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_codigo\": \"U001\",\n  \"categoria_id\": 3,\n  \"descripcion\": \"La VPN corporativa se cae cada 10 minutos desde la oficina principal.\",\n  \"prioridad\": \"Alta\",\n  \"tecnico_id\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets",
              "host": ["{{base_url}}"],
              "path": ["tickets"]
            },
            "description": "Crea un ticket. Guarda el número devuelto en la variable {{numero}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve numero y estado ABIERTO', function () {",
                  "  pm.expect(body.numero).to.match(/^TK-\\d{4}-\\d{6}$/);",
                  "  pm.expect(body.estado).to.eql('ABIERTO');",
                  "});",
                  "if (body.numero) { pm.collectionVariables.set('numero', body.numero); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar estado (ABIERTO -> EN CURSO)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN CURSO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{numero}}/estado",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{numero}}", "estado"]
            },
            "description": "Cambia el estado del ticket. Observación opcional salvo al cerrar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar ticket (EN CURSO -> CERRADO)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"CERRADO\",\n  \"observacion\": \"Se reinstaló el cliente de VPN y se confirmó con el usuario.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{numero}}/estado",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{numero}}", "estado"]
            },
            "description": "Cerrar exige observación (solución aplicada); se guarda en tickets.solucion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('SLA null al cerrar', function () {",
                  "  pm.expect(pm.response.json().sla).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reasignar técnico",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tecnico_id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/tickets/{{numero}}/tecnico",
              "host": ["{{base_url}}"],
              "path": ["tickets", "{{numero}}", "tecnico"]
