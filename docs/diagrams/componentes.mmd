    router --> cTicket & cUsuario & cTecnico & cCategoria
    router --> apikey
    cTicket --> sTicket --> rTicket
    cUsuario --> sUsuario --> rUsuario
    cTecnico --> sTecnico --> rTecnico
    cCategoria --> sCategoria --> rCategoria
