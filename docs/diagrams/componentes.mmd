flowchart TB
    subgraph http["Http"]
        router["Router"]
        request["Request"]
        response["Response"]
        apikey["ApiKeyMiddleware"]
    end

    subgraph ctrl["Controllers (delgados)"]
        cTicket["TicketController"]
        cUsuario["UsuarioController"]
        cTecnico["TecnicoController"]
        cCategoria["CategoriaController"]
    end

