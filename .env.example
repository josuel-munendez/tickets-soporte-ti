# Plantilla de variables de entorno para docker-compose (versionada, sin secretos).
# Copia este archivo a .env y coloca valores reales. .env está en .gitignore.
#
#   cp .env.example .env
#   docker compose up --build

# Puerto público de la aplicación (http://localhost:8080)
APP_PUERTO=8080

# Base de datos
DB_NOMBRE=soporte_ti
DB_USUARIO=soporte
DB_CONTRASENA=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-esta-clave-root
DB_PUERTO_EXTERNO=3307

# API key que exige la API (encabezado X-API-Key). Cámbiala por una propia.
API_KEY=cambia-esta-clave-de-api
