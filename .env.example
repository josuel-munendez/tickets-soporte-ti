# Plantilla de variables de entorno para docker-compose (versionada, sin secretos).
# Copia este archivo a .env y coloca valores reales. .env está en .gitignore.
#
#   cp .env.example .env
#   docker compose up --build

# Puerto público de la aplicación (http://localhost:8080)
APP_PUERTO=8080

# Base de datos (variables sueltas para docker compose)
DB_NOMBRE=soporte_ti
DB_USUARIO=soporte
DB_CONTRASENA=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-esta-clave-root
DB_PUERTO_EXTERNO=3307

# Alternativa para proveedores gestionados (Render, Railway...): en vez de las
# variables sueltas de arriba, define una sola URL de conexión. El entrypoint la
# convierte al formato que espera la app. Ejemplo:
#   DB_URL=mysql://usuario:contrasena@host:3306/soporte_ti
# DB_URL=

# API key que exige la API (encabezado X-API-Key). Cámbiala por una propia.
API_KEY=cambia-esta-clave-de-api

# --- Despliegue "todo en uno" (Dockerfile.allinone) -------------------------
# Para el contenedor único (app + MariaDB) solo se necesita API_KEY. Opcionalmente
# puedes ajustar el usuario/clave de la BD interna (por defecto: soporte/soporte).
#   DB_USUARIO=soporte
#   DB_CONTRASENA=soporte
